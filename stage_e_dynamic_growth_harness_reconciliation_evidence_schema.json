            "stage_d": {"const": 5},
            "continuation": {"const": 3},
            "stage_e": {"const": 11},
            "dynamic_growth": {"const": 44},
            "total": {"const": 63}
          }
        },
        "refusal_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage_d", "continuation", "stage_e", "dynamic_growth_schema", "dynamic_growth_semantic", "assertion_applicator", "total"],
          "properties": {
            "stage_d": {"const": 16},
            "continuation": {"const": 35},
            "stage_e": {"const": 24},
            "dynamic_growth_schema": {"const": 116},
            "dynamic_growth_semantic": {"const": 34},
            "assertion_applicator": {"const": 22},
            "total": {"const": 247}
          }
        },
        "positive_ledger": {
          "type": "array",
          "minItems": 63,
          "maxItems": 63,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/fixture_ledger_row"},
              {"properties": {"disposition": {"const": "ACCEPTED"}}}
            ]
          }
        },
        "refusal_ledger": {
          "type": "array",
          "minItems": 247,
          "maxItems": 247,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/fixture_ledger_row"},
              {"properties": {"disposition": {"const": "REFUSED"}}}
