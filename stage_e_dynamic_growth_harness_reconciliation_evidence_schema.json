        "record_type": {
          "enum": [
            "SCHEMA_REPLAY",
            "RECURSIVE_MOBIUS_GROWTH",
            "DAG_CACHE_CORRECTION",
            "DYNAMIC_GROWTH_ADAPTER_GUARD",
            "HARNESS_ARTIFACT",
            "FINAL_MANIFEST"
          ]
