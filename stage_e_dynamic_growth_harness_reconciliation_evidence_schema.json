{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebu.example/schemas/stage-e-dynamic-growth-harness-reconciliation-evidence-v1.json",
  "title": "EBU Stage E dynamic-growth harness reconciliation evidence",
  "type": "object",
