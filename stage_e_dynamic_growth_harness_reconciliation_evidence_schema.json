        "status": {
          "enum": [
            "PASS",
            "BOUND_NOT_SUPPORTED",
            "REFUSED"
          ]
        },
        "evidence_class": {
          "enum": [
            "STATIC_OR_SYNTHETIC_IMPLEMENTATION_TEST",
            "MATHEMATICAL_DERIVATION_CHECK",
            "NUMERICAL_VERIFICATION",
            "NUMERICAL_VERIFICATION_OF_HARNESS_COMPLEXITY_ONLY"
