              }
            }
          ]
        },
        "derived_keyword_count": {
          "const": 28
        },
        "derived_keywords": {
          "type": "array",
          "prefixItems": [
            {"const": "$defs"},
            {"const": "$id"},
            {"const": "$ref"},
            {"const": "$schema"},
            {"const": "additionalProperties"},
            {"const": "allOf"},
            {"const": "const"},
            {"const": "description"},
            {"const": "else"},
            {"const": "enum"},
            {"const": "format"},
            {"const": "if"},
            {"const": "items"},
            {"const": "maxItems"},
            {"const": "maximum"},
            {"const": "minItems"},
            {"const": "minLength"},
            {"const": "minProperties"},
            {"const": "minimum"},
            {"const": "oneOf"},
            {"const": "pattern"},
            {"const": "prefixItems"},
            {"const": "properties"},
            {"const": "required"},
            {"const": "then"},
            {"const": "title"},
            {"const": "type"},
            {"const": "uniqueItems"}
