          "$ref": "#/$defs/sha256"
        }
      }
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "status",
        "evidence_class",
        "head_commit",
        "head_tree",
        "authority_identity",
        "scientific_zero_counters"
      ],
      "properties": {
        "schema_version": {
          "const": 1
