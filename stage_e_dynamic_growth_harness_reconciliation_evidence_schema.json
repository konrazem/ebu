        "runner_execution_count": {
          "const": 0
        },
        "gate_execution_count": {
          "const": 0
        },
        "simulation_execution_count": {
          "const": 0
        },
        "stochastic_draw_count": {
          "const": 0
        },
        "registered_configuration_count": {
          "const": 0
        },
        "outcome_inspection_count": {
          "const": 0
        },
        "result_count": {
          "const": 0
        },
        "figure_count": {
          "const": 0
        },
        "book_count": {
          "const": 0
        },
        "release_action_count": {
          "const": 0
        },
        "publication_action_count": {
          "const": 0
        }
