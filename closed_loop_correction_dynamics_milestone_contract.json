  "adopted_claims": [
    {
      "id": "CLCD-CT-01",
      "title": "fixed_coordinate_linear_conjugacy",
      "status": "EXACT_UNDER_ASSUMPTIONS",
      "statement": "For fixed complete invertible Z with M=Z^-1, A_I=M A_E Z and the linear systems have equal characteristic polynomials, spectra, algebraic multiplicities, and Jordan structure.",
      "source_claims": [
        "CIIF-CT-06"
      ]
    },
    {
      "id": "CLCD-CT-02",
      "title": "fixed_coordinate_nonlinear_conjugacy",
      "status": "EXACT_UNDER_ASSUMPTIONS",
      "statement": "For g(iota)=M f(Z iota), Dg=M Df Z at corresponding states and Phi_I^t=M Phi_E^t Z when a unique flow exists.",
      "source_claims": [
        "CIIF-CT-07"
      ]
    },
    {
      "id": "CLCD-CT-03",
      "title": "physical_trajectory_influence",
      "status": "MODEL_EXACT_UNDER_DECLARATION",
      "statement": "Delta(t)=P exp(Kt) J-exp(At) is the exact projected physical-trajectory difference for the declared linear augmented system and zero initial correction state.",
      "source_claims": [
        "CIIF-CT-08"
      ]
    },
    {
      "id": "CLCD-CT-04",
      "title": "derivative_path_influence",
      "status": "MODEL_EXACT_UNDER_DECLARATION",
      "statement": "PKJ=A, PK^2J-A^2=BC, and later differences are detected by the complete PK^mJ-A^m sequence, including B D^m C paths.",
      "source_claims": [
        "CIIF-CT-08"
      ]
    },
    {
      "id": "CLCD-CT-05",
      "title": "hidden_correction_memory",
      "status": "MODEL_EXACT_UNDER_DECLARATION",
      "statement": "Eliminating the declared linear correction state yields initial forcing B exp(Dt)c(0) and memory kernel B exp(Dt) C.",
      "source_claims": [
        "CIIF-CT-10"
      ]
    },
    {
      "id": "CLCD-CT-06",
      "title": "continuous_feedback_regimes",
      "status": "MODEL_EXACT_UNDER_DECLARATION",
      "statement": "For lambda^2+(a+d)lambda+(ad+bk), the sign of s=a+d, q=ad+bk, and discriminant s^2-4q determines the frozen stability and oscillation regimes.",
      "source_claims": [
        "CIIF-CT-11"
      ]
    },
    {
      "id": "CLCD-CT-07",
      "title": "discrete_delay_regimes",
      "status": "MODEL_EXACT_UNDER_DECLARATION",
      "statement": "The immediate scalar controller is stable for 0<kappa<2; the frozen one-step delayed recurrence is stable for 0<kappa<1 and damped oscillatory for 1/4<kappa<1.",
      "source_claims": [
        "CIIF-CT-12"
      ]
    },
    {
      "id": "CLCD-CT-08",
      "title": "mode_observability",
      "status": "MODEL_EXACT_UNDER_DECLARATION",
      "statement": "For output y=H x, an eigenmode v is directly visible only when H v is nonzero.",
      "source_claims": [
        "CIIF-CT-08",
        "CIIF-CT-13"
      ]
    },
    {
      "id": "CLCD-DO-09",
      "title": "comparative_diagnostic_protocol",
      "status": "PROSPECTIVE_DESIGN_OBLIGATION",
      "statement": "A frozen before-after study reports trajectories, equilibria, roots, damping, period, overshoot, recovery, delay margin, observability, correction action or work, Delta, residual, and failures.",
      "source_claims": [
        "CIIF-CT-13"
      ]
    },
    {
      "id": "CLCD-DO-10",
      "title": "immutable_correction_action_receipt",
      "status": "PROSPECTIVE_DESIGN_OBLIGATION",
      "statement": "Original and corrective actions retain distinct immutable receipts with provenance, lifecycle, delay, residual, resource or cost, dependency, audit, and applicable appeal references.",
      "source_claims": [
        "CIIF-EA-14"
      ]
    },
    {
      "id": "CLCD-DO-11",
      "title": "correction_closure",
      "status": "PROSPECTIVE_DESIGN_OBLIGATION",
      "statement": "Correction accounts declare typed stock change, boundary transfers, generation, consumption, residual, internal-transfer roll-up, and disjoint or reconciled original/correction process accounts.",
      "source_claims": [
        "CIIF-EA-15"
      ]
    },
    {
      "id": "CLCD-DO-12",
      "title": "dependency_propagation",
      "status": "PROSPECTIVE_DESIGN_OBLIGATION",
      "statement": "Corrections invalidate or recompute reachable dependents through explicit acyclic provenance edges and emit new versions without mutating history.",
      "source_claims": [
        "CIIF-EA-16"
      ]
    },
    {
      "id": "CLCD-HYP-13",
      "title": "conditional_self_regulation",
      "status": "INSTITUTIONAL_HYPOTHESIS",
      "statement": "Bounded residual-triggered correction may improve learning and recovery when gain, delay, closure, privacy, disclosure, and contestability conditions are satisfied.",
      "source_claims": [
        "CIIF-HYP-02",
        "CIIF-HYP-03"
      ]
    },
    {
      "id": "CLCD-NC-14",
      "title": "nonclaim_boundary",
      "status": "NONCLAIM_EXCLUSION",
      "statement": "The milestone establishes no universal controller, perfect efficiency, universal convergence, physical wave, voltage, causal attribution, fairness, settlement, automatic topology inference, or empirical validity."
    }
