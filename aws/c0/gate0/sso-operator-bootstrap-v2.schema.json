    "preparation_session_policy_requirements",
    "rollback",
    "schema",
    "sessions",
    "superseded_gate0_packet_sha256",
    "supersedes_only",
    "trust_policy"
  ],
  "title": "EBU AWS-C0 exact SSO source-identity bootstrap material v2",
  "type": "object"
}
